": "04d836q62", "scheme": "ror"}, {"identifier": "grid.5329.d", "scheme": "grid"}, {"identifier": "0000 0004 1937 0669", "scheme": "isni"}]}]}, {"person_or_org": {"type": "organizational", "name": "TU Wien", "identifiers": [{"identifier": "04d836q62", "scheme": "ror"}]}, "role": {"id": "projectmember", "title": {"ar": "\u0639\u0636\u0648 \u0628\u0627\u0644\u0645\u0634\u0631\u0648\u0639", "cs": "\u010clen projektu", "de": "Projektmitglied", "en": "Project member", "es": "Miembro del proyecto", "sv": "Projektmedlem"}}}, {"person_or_org": {"type": "organizational", "name": "University of Vienna", "identifiers": [{"identifier": "03prydq77", "scheme": "ror"}]}, "role": {"id": "projectmember", "title": {"ar": "\u0639\u0636\u0648 \u0628\u0627\u0644\u0645\u0634\u0631\u0648\u0639", "cs": "\u010clen projektu", "de": "Projektmitglied", "en": "Project member", "es": "Miembro del proyecto", "sv": "Projektmedlem"}}}, {"person_or_org": {"type": "organizational", "name": "Deutsches Arch\u00e4ologisches Institut, Abteilung Cairo", "identifiers": [{"identifier": "05wps8h17", "scheme": "ror"}]}, "role": {"id": "projectmember", "title": {"ar": "\u0639\u0636\u0648 \u0628\u0627\u0644\u0645\u0634\u0631\u0648\u0639", "cs": "\u010clen projektu", "de": "Projektmitglied", "en": "Project member", "es": "Miembro del proyecto", "sv": "Projektmedlem"}}}, {"person_or_org": {"type": "organizational", "name": "TU Wien", "identifiers": [{"identifier": "04d836q62", "scheme": "ror"}]}, "role": {"id": "rightsholder", "title": {"ar": "\u0635\u0627\u062d\u0628 \u0627\u0644\u062d\u0642\u0648\u0642", "cs": "Dr\u017eitel pr\u00e1v", "de": "RechteinhaberIn", "en": "Rights holder", "es": "Titular de derechos", "sv": "R\u00e4ttighetsinnehavare"}}}], "rights": [{"id": "cc-by-nc-nd-4.0", "title": {"en": "Creative Commons Attribution Non Commercial No Derivatives 4.0 International"}, "description": {"en": ""}, "icon": "cc-by-nc-nd-icon", "props": {"url": "https://creativecommons.org/licenses/by-nc-nd/4.0/", "scheme": "spdx"}}], "description": "<h2>Related work</h2>\n<p>This dataset is part of the digital documentation of the Tomb of Meret Neith, Umm el Qaab, Abydos, Egypt about 3000BC, its artefacts, and the reconstruction of the tomb. For an overview of the related work, please visit <a href=\"https://researchdata.tuwien.at/communities/meretneith/\">https://researchdata.tuwien.at/communities/meretneith/</a>.</p>\n<h2>Archaeological information</h2>\n<h3>Object name</h3>\n<p>Coffin fragment</p>\n<h3>Object number(s)</h3>\n<p>LN1734</p>\n<h3>Description</h3>\n<p>four coffin fragments, coffin of S0</p>\n<h3>Location of object at time of photographs</h3>\n<p>MoTA storage</p>\n<h3>Find location</h3>\n<p>Tomb Y; Y-S0 (DAI); context coffin of S0</p>\n<h3>Bibliography</h3>\n<p>N/A</p>\n<h2>Technical Information</h2>\n<p>For imaging, Canon RAW and Apple RAW images were captured.</p>\n<h3>Physical properties</h3>\n<table>\n  <tbody>\n    <tr>\n      <td>Length (cm)</td>\n      <td>N/A</td>\n    </tr>\n    <tr>\n      <td>Width (cm)</td>\n      <td>N/A</td>\n    </tr>\n    <tr>\n      <td>Height (cm)</td>\n      <td>N/A</td>\n    </tr>\n    <tr>\n      <td>Weight (g)</td>\n      <td>N/A</td>\n    </tr>\n    <tr>\n      <td>Volume (cm3)</td>\n      <td>N/A</td>\n    </tr>\n    <tr>\n      <td>Density (g/cm3)</td>\n      <td>N/A</td>\n    </tr>\n  </tbody>\n</table>\n<h3>Comments</h3>\n<p>this dataset contains an unsorted collection of four fragments (1734a, 1734b, 1734c, 1734d)</p>\n<h3>Files overview</h3>\n<ul>\n  <li><b>images_videos.zip</b> contains photographs of the real object in RAW format.</li>\n  <li>[optional] <b>exports_{H,M,L}Q.zip</b> archives contain the scanned object as 3D model in OBJ format including MTL and texture files. HQ, MQ, and LQ refer to high, medium and low quality versions of the model.</li>\n  <li>[optional] <b>{objectName}_report.pdf</b> contains further technical information of the reconstruction process.</li>\n</ul>", "funding": [{"funder": {"id": "013tf3c58", "name": "FWF Austrian Science Fund"}, "award": {"number": "I 4688-G", "title": {"en": "Visualizing an Ancient Egyptian Queen"}, "identifiers": [{"identifier": "https://www.fwf.ac.at/forschungsradar/10.55776/I4688", "scheme": "url"}]}}, {"funder": {"id": "018mejw64", "name": "Deutsche Forschungsgemeinschaft"}, "award": {"number": "434209459", "title": {"en": "Visualizing an Ancient Egyptian Queen - The Tomb of the 1st Dynasty Queen Meret-Neith at Abydos"}, "identifiers": [{"identifier": "https://gepris.dfg.de/gepris/projekt/434209459", "scheme": "url"}]}}]}, "custom_fields": {}, "access": {"record": "public", "files": "restricted", "embargo": {"active": false, "reason": null}, "status": "restricted"}, "files": {"enabled": true}, "media_files": {"enabled": false}, "status": "published", "deletion_status": {"is_deleted": false, "status": "P"}, "stats": {"this_version": {"views": 88, "unique_views": 83, "downloads": 0, "unique_downloads": 0, "data_volume": 0.0}, "all_versions": {"views": 88, "unique_views": 83, "downloads": 0, "unique_downloads": 0, "data_volume": 0.0}}}