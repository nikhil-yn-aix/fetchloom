{"data":{"id":"w867p","type":"nodes","attributes":{"title":"Replication package for: A Collaborative Intelligence Framework for Siting Shared Parcel Lockers in Los Angeles County","description":"Companion data, code and results for the manuscript 'A Collaborative Intelligence Framework for Siting Shared Parcel Lockers in Los Angeles County' by Heliang Wei (Rutgers University Newark College, Northeast Normal University), submitted to the Annals of Operations Research special issue Collaborative Intelligence in Operations Research.\n\nThe package contains everything needed to regenerate every number, table and figure in the manuscript from public sources: five analysis scripts in code/, the input data in data/ (three CC0 archive files copied from Fang 2020, DOI 10.7910/DVN/QTUW3J, plus the CensusReporter extract for ACS 2024 table B01003), the derived result files in results/ and the six figures in figures/. See README.md for run instructions and for the persistent identifiers of every source.\n\nData sources: Harvard Dataverse DOI 10.7910/DVN/QTUW3J; American Community Survey 2024 five year estimates table B01003 via CensusReporter; Open Source Routing Machine public table service on OpenStreetMap. Original archive files are CC0 1.0; analysis code is released under the MIT licence.","category":"data","custom_citation":null,"date_created":"2026-10-21T12:47:24.991679","date_modified":"2026-10-21T13:05:16.801300","registration":false,"preprint":false,"fork":false,"collection":false,"tags":["collaborative intelligence","facility location","last mile delivery","Los Angeles","operations research","parcel locker","replication"],"access_requests_enabled":true,"node_license":null,"analytics_key":"","current_user_can_comment":false,"current_user_permissions":["read"],"current_user_is_contributor":false,"current_user_is_contributor_or_group_member":false,"wiki_enabled":true,"public":true,"subjects":[]},"relationships":{"children":{"links":{"related":{"href":"https://api.osf.io/